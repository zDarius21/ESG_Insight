# Configurazione condivisa di ESG Insight.
# Copiare in .env: viene letto da docker compose, dal backend (npm run dev) e dal motore AI (runserver).
# In Docker gli host (DB_HOST, MINIO_ENDPOINT, AI_ENGINE_URL) vengono sovrascritti da docker-compose.yml.

# ─── PostgreSQL ───────────────────────────────────────────
DB_NAME=compliance_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# ─── MinIO (storage dei PDF e dei report) ─────────────────
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_DOCUMENTS_BUCKET=compliance-documents
MINIO_REPORTS_BUCKET=compliance-reports

# ─── Backend Express ──────────────────────────────────────
PORT=3000
# Chiavi RSA per i JWT (RS256), percorsi relativi alla cartella backend/
JWT_PRIVATE_KEY_PATH=keys/private.pem
JWT_PUBLIC_KEY_PATH=keys/public.pem
JWT_EXPIRES_IN=1h
# Motore AI e tempo massimo di attesa di un'analisi (ms)
AI_ENGINE_URL=http://localhost:8000
AI_ENGINE_TIMEOUT_MS=300000

# ─── Motore AI (Django) ───────────────────────────────────
DJANGO_SECRET_KEY=change-me-in-production
# LLM locale: il modello principale (Llama 3.2) richiede un token Hugging Face con accesso approvato,
# altrimenti viene usato il fallback TinyLlama
LOCAL_LLM_MODEL=meta-llama/Llama-3.2-3B-Instruct
LOCAL_LLM_FALLBACK_MODEL=TinyLlama/TinyLlama-1.1B-Chat-v1.0
LOCAL_LLM_MAX_NEW_TOKENS=512
# Normative valutate dall'LLM per ogni analisi; 0 = solo embedding + regole (più veloce, meno RAM)
MAX_SEMANTIC_EVALUATIONS=2
HF_TOKEN=

# ─── Frontend ─────────────────────────────────────────────
# Porta pubblicata dal container nginx (http://localhost:8080)
FRONTEND_PORT=8080
